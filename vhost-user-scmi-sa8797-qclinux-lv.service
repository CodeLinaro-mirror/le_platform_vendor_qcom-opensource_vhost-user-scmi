[Unit]
Description=Service for lv vhost-user-scmi

After= remote-fs.target

Before = qcrosvm_qclinux_lv.service

[Service]
Slice=gvm.slice
Type=notify
NotifyAccess=main

ExecStart=/usr/bin/vhost-user-scmi \
-l level=debug \
-s /tmp/pt-lv-dev-skt \
-f 0/300:1200:2400:4800:9600:19200:38400:57600:115200:230400:460800:921600:2000000:3000000:4000000:8000000,1/10:100:1000:2500:5000:10000,2/10:100:1000:2500:5000,3/300:1200:2400:4800:9600:19200:38400:57600:115200:230400:460800:921600:2000000:3000000:4000000:8000000 \
-p 10 \
-r 2 \
-d /dev/scmi_uart3,19/0/perf,17/0/power \
-d /dev/scmi_emac1,17/8/emac_power,17/9/emac_clock,19/1/emac_perf,19/2/perf_5g_serdes,22/0/emac_reset,22/1/serdes_reset \
-d /dev/scmi_uart17,19/3/perf,17/2/power

[Install]
WantedBy = single-lv-gvm.target