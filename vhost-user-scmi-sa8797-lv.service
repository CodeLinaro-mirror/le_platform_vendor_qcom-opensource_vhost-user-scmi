[Unit]
Description=Service for lv vhost-user-scmi

After= remote-fs.target

Before = qcrosvm_lv.service

[Service]
Slice=gvm.slice
Type=notify
NotifyAccess=main

ExecStart=/usr/bin/vhost-user-scmi \
-l level=debug \
-s /tmp/pt-lv-dev-skt \
-f 0/300:1200:2400:4800:9600:19200:38400:57600:115200:230400:460800:921600:2000000:3000000:4000000:8000000,1/1:10:50:100:500:1000:5000:10000:15000:20000:25000:30000:35000:40000:45000:50000 \
-p 3 \
-d /dev/scmi_uart3,19/0/perf,17/0/power \
-d /dev/scmi_spi21,19/1/perf,17/1/power \
-d /dev/scmi_i2c13,17/2/power

[Install]
WantedBy = multi-gvm.target
