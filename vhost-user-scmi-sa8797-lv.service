[Unit]
Description=Service for lv vhost-user-scmi

After= remote-fs.target

Before = qcrosvm_lv.service

[Service]
Slice=gvm.slice
Type=notify
NotifyAccess=main

ExecStart=/usr/bin/vhost-user-scmi \
-l level=debug \
-s /tmp/pt-lv-dev-skt \
-f 0/300:1200:2400:4800:9600:19200:38400:57600:115200:230400:460800:921600:2000000:3000000:4000000:8000000 \
-p 1 \
-d /dev/scmi_uart3,19/0/perf,17/0/power

[Install]
WantedBy = multi-user.target
