[Unit]
Description=Service to start the vhost-user-scmi

After= remote-fs.target

Before = qcrosvm.service

[Service]
Type=simple
ExecStart=/usr/bin/vhost-user-scmi \
-l level=debug \
-s /tmp/pt-dev-skt

[Install]
WantedBy = multi-user.target
